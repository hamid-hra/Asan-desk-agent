# آدرس دریافت گزارش پنل (از دیالوگ «افزودن سرور» در پنل)
AGENT_URL=https://panel.example.com/api/agent/ingest
# توکن مخصوص همین سرور؛ آن را جایی عمومی نگذارید
AGENT_TOKEN=
# پوشهٔ دادهٔ hbbs روی این سرور (شامل id_ed25519.pub و db_v2.sqlite3). روی سروری که hbbs ندارد این خط را پاک کنید
HBBS_DATA=/path/to/hbbs-data
